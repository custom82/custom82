+def _spawn_compat(cmd, dry_run=False):
+    """
+    distutils.spawn.spawn() signature differs depending on provider.
+    With setuptools._distutils (common with Python 3.13 toolchains), spawn() may not
+    accept 'dry_run' as a keyword argument.
+    Keep behavior: in dry-run mode, do nothing; otherwise execute the command.
+    """
+    if dry_run:
+        return
+    try:
+        return spawn(cmd, dry_run=dry_run)
+    except TypeError:
+        return spawn(cmd)
+
