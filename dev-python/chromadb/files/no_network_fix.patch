+async fn execute_query(tx: &mut ReadOnlyTransaction, stmt: Statement) -> Vec<Row> {
+    let reader = match tx.query(stmt).await {
+        Ok(tx) => tx,
+        Err(status) => panic!("query error {status:?}"),
+    };
+    all_rows(reader).await.unwrap()
