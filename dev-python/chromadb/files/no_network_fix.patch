diff '--color=auto' -uPNr chroma-1.4.1/rust/google-cloud-rust/google-cloud-rust-20251222/storage/src/http/objects/patch.rs chroma-1.4.1-patch/rust/google-cloud-rust/google-cloud-rust-20251222/storage/src/http/objects/patch.rs
