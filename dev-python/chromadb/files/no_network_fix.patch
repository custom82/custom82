+    let stmt = Statement::new(format!(
+        "SELECT * FROM User p WHERE p.UserId LIKE 'user_partition_{}_%' ",
+        now.unix_timestamp()
+    ));
+    let rows = execute_partitioned_query(&mut tx, stmt).await;
+    assert_eq!(20000, rows.len());
+}
