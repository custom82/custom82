+                println!("partition count {:?}", res.into_inner().partitions.len());
+                assert_eq!(true, true);
+            }
+            Err(err) => {
+                println!("error code = {0}, {1}", err.code(), err.message());
+                assert_eq!(false, true)
+            }
+        };
+    }
+}
