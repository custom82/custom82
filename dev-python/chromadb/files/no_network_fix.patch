+                            col_binary: row.column(8).unwrap(),
+            }           );
+                    }else {
+                        tracing::info!("read row none");
+                        finish2 = true;
+                        if finish1 && finish2 {
+                            break;
+                        }
+                    }
+                }
+            }
+        }
+        assert_eq!(data_as_struct.len(), 3);
+        assert_eq!(data_as_row.len(), 1);
+
+        assert_data(&now, data_as_struct);
+        assert_data(&now, data_as_row);
+    }
