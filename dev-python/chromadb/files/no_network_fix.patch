+            content_type: Some(content_type.to_string()),
+            ..SignedURLOptions::default()
+        };
+        let url = client
+            .signed_url(&bucket_name, "signed_uploadtest", None, None, option)
+            .await
+            .unwrap();
+        println!("downloading={url:?}");
+        let result = reqwest::Client::default()
+            .get(url)
