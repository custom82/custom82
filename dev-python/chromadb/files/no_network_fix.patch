+async fn assert_query(tx: &mut ReadOnlyTransaction, user_id: &str, now: &OffsetDateTime, cts: &OffsetDateTime) {
+    let mut stmt = Statement::new("SELECT * FROM User WHERE UserId = @UserID");
+    stmt.add_param("UserId", &user_id);
