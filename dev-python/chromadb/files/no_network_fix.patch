+                let _ = message.ack().await;
+                tracing::info!("acked {}", message.message.message_id);
+                acked += 1;
+            }
+            let nack_msgs = iter.dispose().await;
+            assert_eq!(nack_msgs, 0);
+            tracing::info!("disposed");
+            acked
+        });
+
+        tokio::time::sleep(Duration::from_secs(20)).await;
