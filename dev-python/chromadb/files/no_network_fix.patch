+    pub is_last_record_in_transaction_in_partition: bool,
+    pub table_name: String,
+    pub mod_type: String,
+    pub value_capture_type: String,
+    pub number_of_records_in_transaction: i64,
+    pub number_of_partitions_in_transaction: i64,
