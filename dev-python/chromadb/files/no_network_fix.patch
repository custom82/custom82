+    lro_client: OperationsClient,
+}
+
+impl InstanceAdminClient {
+    pub fn new(channel: Channel, lro_client: OperationsClient) -> Self {
+        Self {
+            inner: InternalInstanceAdminClient::new(channel).max_decoding_message_size(i32::MAX as usize),
+            lro_client,
+        }
+    }
