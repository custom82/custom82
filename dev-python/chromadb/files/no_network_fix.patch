+    let stmt = Statement::new(
+        "SELECT
+                cast(\"-99999999999999999999999999999.999999999\" as numeric),
+                cast(\"-99999999999999999999999999999\" as numeric),
+                cast(\"-0.999999999\" as numeric),
+                 cast(\"0\" as numeric),
+                 cast(\"0.999999999\" as numeric),
+                 cast(\"99999999999999999999999999999\" as numeric),
+                 cast(\"99999999999999999999999999999.999999999\" as numeric)",
