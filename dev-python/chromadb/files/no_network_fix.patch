+#[derive(Clone, Debug)]
+pub struct ChannelConfig {
+    /// num_channels is the number of gRPC channels.
+    num_channels: usize,
+    connect_timeout: Option<Duration>,
+    timeout: Option<Duration>,
+}
+
+impl ChannelConfig {
