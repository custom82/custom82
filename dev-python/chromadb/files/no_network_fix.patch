+    let data_client = create_data_client().await;
+    data_client.apply(many).await.unwrap();
+
+    // test
+    let client = Client::new(DATABASE, ClientConfig::default()).await.unwrap();
+    let mut tx = client.batch_read_only_transaction().await.unwrap();
