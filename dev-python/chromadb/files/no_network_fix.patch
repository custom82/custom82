+impl Default for ClientConfig {
+    fn default() -> Self {
+        let mut config = ClientConfig {
+            channel_config: Default::default(),
+            session_config: Default::default(),
+            endpoint: SPANNER.to_string(),
+            environment: match var("SPANNER_EMULATOR_HOST").ok() {
