diff '--color=auto' -uPNr chroma-1.4.1/rust/google-cloud-rust/foundation/longrunning/src/autogen/operations_client.rs chroma-1.4.1-patch/rust/google-cloud-rust/foundation/longrunning/src/autogen/operations_client.rs
