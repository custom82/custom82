+                .map_transient_err()
+        };
+        invoke(retry, action)
+            .await
+            .map(|d| Operation::new(self.lro_client.clone(), d.into_inner()))
+    }
+
+    /// drop_database drops (aka deletes) a Cloud Spanner database.
