+#[derive(thiserror::Error, Debug)]
+pub enum Error {
+    #[error(transparent)]
+    GAX(#[from] google_cloud_gax::conn::Error),
+    #[error("Project ID was not found")]
+    ProjectIdNotFound,
+}
