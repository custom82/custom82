+    }
+
+    #[tokio::test]
+    #[serial]
+    async fn test_get_instance_config() {
+        let client = new_client().await;
+        let name = "projects/local-project/instanceConfigs/emulator-config".to_string();
+        let request = GetInstanceConfigRequest { name: name.clone() };
