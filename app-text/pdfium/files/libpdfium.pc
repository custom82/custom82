prefix=%{_prefix}
exec_prefix=%{_exec_prefix}
libdir=%{_libdir}
includedir=%{_includedir}

Name: %{name}
Description: Library for PDF rendering, inspection, manipulation and creation
Version: %{version}
Cflags: -I\${includedir}
Requires.private: -lfreetype -licuuc -ljpeg -llcms2 -lopenjp2 -lz
Libs: -L\${libdir} -lpdfium
